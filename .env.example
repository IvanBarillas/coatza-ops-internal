# Copiar como .env.dev para desarrollo local, .env.container para
# ejecución en Podman (docker-compose.dev.yml) o .env.prod para producción.
# Los archivos reales están ignorados por Git.
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=core.settings.development
DEBUG=True
SECRET_KEY=change-this-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL. Dentro de Compose el host es "db".
POSTGRES_USER=axentra
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=axentra
DATABASE_URL=postgresql://axentra:change-this-password@db:5432/axentra

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.invalid
AXENTRA_OWNER_EMAIL=owner@example.invalid
AXENTRA_OWNER_DEFAULT_PASSWORD=change-this-password
ADMIN_SECRET_PATH=admin/
AXENTRA_CORE_VERBOSE_RADAR=False

# Producción: usar DJANGO_ENV=prod y DJANGO_SETTINGS_MODULE=core.settings.production.
# Configurar HTTPS del ayuntamiento en CSRF_TRUSTED_ORIGINS y ALLOWED_HOSTS.
# Estas variables de puertos se interpolan mediante --env-file .env.prod en Compose.
AXENTRA_BIND_ADDRESS=127.0.0.1
AXENTRA_HTTP_PORT=8000
# SMTP requerido por settings de producción; no contiene credenciales reales.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# OP#38: configurar SMTP antes de operar con correo obligatorio.
AXENTRA_REQUIRE_ADMIN_MFA=True
AXENTRA_REQUIRE_VERIFIED_EMAIL=True
OTP_TOTP_ISSUER=Axentra OS

# Cola de tareas asíncronas (Django-Q2, broker ORM — sin Redis/RabbitMQ).
# Q_CLUSTER_SYNC solo aplica en desarrollo: True corre la tarea en el mismo
# proceso al hacer commit (sin exigir un `manage.py qcluster` aparte); False
# prueba el flujo asíncrono real contra el worker. En producción siempre es
# asíncrono (ver core/settings/production.py) y no es configurable.
Q_CLUSTER_SYNC=True
Q_CLUSTER_WORKERS=2
# Segundos antes de dar por colgado un SMTP sin respuesta (solo producción).
EMAIL_TIMEOUT=10
