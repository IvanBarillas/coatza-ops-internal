# Configuración NO secreta del entorno semi real DEV. Se copia a ~/.config/axentra-core/axentra-core.env
# Los secretos (SECRET_KEY, DATABASE_URL, INTERNAL_API_KEY, contraseñas) van por `podman secret`, nunca aquí.
DJANGO_ENV=prod
DJANGO_SETTINGS_MODULE=core.settings.production

# Dominios. `axentra-core` es el nombre interno con el que Hermes llama a la API por la red frontend.
ALLOWED_HOSTS=digital-dev.axentra.com.mx,ciudadano-dev.axentra.com.mx,axentra-core
CSRF_TRUSTED_ORIGINS=https://digital-dev.axentra.com.mx,https://ciudadano-dev.axentra.com.mx

# El dominio ciudadano sirve el urlconf público compuesto (core.urls_publico).
AXENTRA_HOST_URLCONFS=ciudadano-dev.axentra.com.mx=core.urls_publico

# La redirección a HTTPS sigue ACTIVA. Solo se exime la API (Hermes llama por http interno; Traefik ya
# redirige todo lo externo y no expone /api/).
SECURE_SSL_REDIRECT=True
SECURE_REDIRECT_EXEMPT=^api/v1/

# Enlaces entre dominios (superficie ciudadana, con el prefijo de cada satélite). Nunca reverse().
TRAMITES_PUBLIC_BASE_URL=https://ciudadano-dev.axentra.com.mx/tramites
CIUDADANIA_PUBLIC_BASE_URL=https://ciudadano-dev.axentra.com.mx/ciudadano
SITUACIONES_PUBLIC_BASE_URL=https://ciudadano-dev.axentra.com.mx/situaciones

# Espejo Redis de Trámites APAGADO (decisión vigente): TRAMITES_REDIS_URL no se define; el satélite lo lee con
# valor por defecto vacío.

# Identidad del propietario inicial (la contraseña va en el secreto axentra_core_owner_password, solo al ejecutar
# el bootstrap; ver RUNBOOK).
AXENTRA_OWNER_EMAIL=owner@axentra.com.mx
OTP_TOTP_ISSUER=Axentra OS (DEV)

# SMTP: el entorno DEV no envía correo real. Los ajustes de producción exigen las tres variables.
EMAIL_HOST=localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@axentra.com.mx
